{
	"schemaVersion": 1,
	"id": "legacylogo",
	"version": "${version}",
	"name": "Legacy Logo",
	"description": "A continuation of Classic Minecraft Logo, originally created by lassebq. Maintained and updated by Mazeriio for modern Minecraft versions.",
	"authors": [
		"lassebq", "Mazeriio"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/legacy-logo",
		"issues": "https://github.com/Mazetta/legacylogo/issues",
		"sources": "https://github.com/Mazetta/legacylogo"
	},
	"license": "MIT",
	"icon": "assets/legacylogo/icon.png",
	"environment": "client",
	"entrypoints": {
		"modmenu": [
			"io.github.lassebq.legacylogo.ModMenuIntegration"
		],
		"client": [
			"io.github.lassebq.legacylogo.Mod"
		]
	},
	"mixins": [
		{
			"config": "legacylogo.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "26.3",
		"java": ">=25",
		"cloth-config2": "*"
	},
	"suggests": {
	}
}